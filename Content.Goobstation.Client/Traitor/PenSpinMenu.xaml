<ui:FancyWindow xmlns="https://spacestation14.io"
             xmlns:ui="using:Content.Client.UserInterface.Controls"
             Title="{Loc 'pen-spin-window-title'}"
             MinSize="260 140"
             SetSize="320 180">
    <BoxContainer Orientation="Vertical" Margin="8">
        <Label Text="{Loc 'pen-spin-degree-label'}" />
        <LineEdit Name="DegreeInput" Text="0" />
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 8 0 0">
            <Button Name="ResetButton" Text="{Loc 'pen-spin-reset-button'}" />
            <Button Name="SubmitButton" Text="{Loc 'pen-spin-submit-button'}" />
        </BoxContainer>
    </BoxContainer>
</ui:FancyWindow>
