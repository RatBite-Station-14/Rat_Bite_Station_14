<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:ui="clr-namespace:Content.Client.Pinpointer.UI"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc marker-monitor-ui-title}"
                      Resizable="False"
                      SetSize="1100 700"
                      MinSize="1100 700">
    <BoxContainer Orientation="Vertical">
        <BoxContainer Orientation="Horizontal" VerticalExpand="True" HorizontalExpand="True">
            <ui:NavMapControl Name="NavMap" HorizontalExpand="True" VerticalExpand="True" Margin="5 20" />
            <BoxContainer Orientation="Vertical">
                <ScrollContainer
                    VerticalExpand="True"
                    SetWidth="520"
                    Margin="8, 8, 8, 8">
                    <BoxContainer Orientation="Vertical"  Margin="85,8,8,8">
                    <Label Text="{Loc 'marker-monitor-marker-label'}" Margin="0,0,0,15"></Label>
                    <GridContainer Name="MarkerGrid">
                    </GridContainer>
                    </BoxContainer>
                </ScrollContainer>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
