<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    MinWidth="512"
    MinSize="512 256">
    <BoxContainer Orientation="Vertical">
        <BoxContainer Orientation="Horizontal" VerticalExpand="True">
            <PanelContainer
                Name="IngredientsPanel"
                Access="Public"
                MinSize="300 128"
                HorizontalExpand="True"
                Margin="5 5"
                >
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" />
                </PanelContainer.PanelOverride>
                <ScrollContainer
                    VerticalExpand="True"
                    HorizontalExpand="True"
                    HScrollEnabled="False"
                    >
                    <BoxContainer
                        Name="IngredientsList"
                        Access="Public"
                        Orientation="Vertical"
                        HorizontalExpand="True" />
                </ScrollContainer>
            </PanelContainer>
        </BoxContainer>
        <Button
            Name="EjectButton"
            Access="Public"
            Text="{Loc 'microwave-menu-eject-all-text'}"
            ToolTip="{Loc 'microwave-menu-eject-all-tooltip'}"
            StyleClasses="negative"
            TextAlign="Center"
            HorizontalExpand="True"
            Margin="5 0 5 5"/>
    </BoxContainer>
    <PanelContainer Name="DisableCookingPanelOverlay" MouseFilter="Stop">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#1B1B1E66" />
        </PanelContainer.PanelOverride>
    </PanelContainer>
</controls:FancyWindow>
